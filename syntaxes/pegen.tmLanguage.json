{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Pegen PEG",
	"patterns": [
		{
			"include": "#comment"
		},
		{
			"include": "#meta"
		},
		{
			"include": "#rule-definition"
		},
		{
			"include": "#expression"
		}
	],
	"repository": {
		"comment": {
			"name": "comment.line.number-sign.pegen",
			"match": "#.*$"
		},
		"meta": {
			"name": "meta.directive.pegen",
			"begin": "^(@)([A-Za-z_]\\w*)",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.directive.pegen"
				},
				"2": {
					"name": "keyword.other.directive.pegen"
				}
			},
			"end": "$",
			"patterns": [
				{
					"include": "#comment"
				},
				{
					"include": "#triple-string"
				},
				{
					"include": "#strings"
				},
				{
					"name": "variable.other.directive-value.pegen",
					"match": "[A-Za-z_]\\w*"
				}
			]
		},
		"rule-definition": {
			"name": "meta.rule.definition.pegen",
			"begin": "^([A-Za-z_]\\w*)(?=\\s*[\\[(:])",
			"beginCaptures": {
				"1": {
					"name": "entity.name.class.pegen"
				}
			},
			"end": "(:)|$",
			"endCaptures": {
				"1": {
					"name": "punctuation.separator.rule.pegen"
				}
			},
			"patterns": [
				{
					"include": "#type-annotation"
				},
				{
					"name": "meta.rule.flags.pegen",
					"begin": "\\(",
					"end": "\\)",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.flags.begin.pegen"
						}
					},
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.flags.end.pegen"
						}
					},
					"patterns": [
						{
							"name": "storage.modifier.flag.pegen",
							"match": "[A-Za-z_]\\w*"
						},
						{
							"name": "punctuation.separator.comma.pegen",
							"match": ","
						}
					]
				}
			]
		},
		"type-annotation": {
			"name": "meta.annotation.type.pegen",
			"begin": "\\[",
			"end": "\\]",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.annotation.begin.pegen"
				}
			},
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.annotation.end.pegen"
				}
			},
			"patterns": [
				{
					"include": "#type-annotation-content"
				}
			]
		},
		"type-annotation-content": {
			"patterns": [
				{
					"begin": "\\[",
					"end": "\\]",
					"patterns": [
						{
							"include": "#type-annotation-content"
						}
					]
				},
				{
					"include": "#strings"
				},
				{
					"name": "storage.modifier.pointer.pegen",
					"match": "\\*"
				},
				{
					"name": "storage.type.pegen",
					"match": "[A-Za-z_]\\w*"
				}
			]
		},
		"expression": {
			"patterns": [
				{
					"include": "#comment"
				},
				{
					"include": "#action"
				},
				{
					"include": "#strings"
				},
				{
					"include": "#named-item"
				},
				{
					"include": "#operators"
				},
				{
					"include": "#token"
				},
				{
					"name": "constant.language.pegen",
					"match": "\\b(True|False|None)\\b"
				},
				{
					"name": "entity.name.function.pegen",
					"match": "[A-Za-z_]\\w*"
				}
			]
		},
		"named-item": {
			"match": "\\b([A-Za-z_]\\w*)\\s*(?:(\\[)([^\\]=]*)(\\]))?\\s*(=)",
			"captures": {
				"1": {
					"name": "entity.name.tag.pegen"
				},
				"2": {
					"name": "punctuation.definition.annotation.begin.pegen"
				},
				"3": {
					"patterns": [
						{
							"include": "#type-annotation-content"
						}
					]
				},
				"4": {
					"name": "punctuation.definition.annotation.end.pegen"
				},
				"5": {
					"name": "keyword.operator.assignment.pegen"
				}
			}
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.forced.pegen",
					"match": "&&"
				},
				{
					"name": "keyword.operator.lookahead.pegen",
					"match": "&|!"
				},
				{
					"name": "keyword.control.cut.pegen",
					"match": "~"
				},
				{
					"name": "keyword.operator.alternative.pegen",
					"match": "\\|"
				},
				{
					"name": "keyword.operator.quantifier.pegen",
					"match": "[?*+]"
				},
				{
					"name": "keyword.operator.gather.pegen",
					"match": "\\."
				},
				{
					"name": "keyword.operator.endmarker.pegen",
					"match": "\\$"
				},
				{
					"name": "punctuation.parenthesis.pegen",
					"match": "[()]"
				},
				{
					"name": "punctuation.brackets.optional.pegen",
					"match": "[\\[\\]]"
				}
			]
		},
		"token": {
			"name": "constant.other.token.pegen",
			"match": "\\b[A-Z][A-Z0-9_]*\\b"
		},
		"strings": {
			"patterns": [
				{
					"include": "#triple-string"
				},
				{
					"name": "string.quoted.single.pegen",
					"begin": "'",
					"end": "'|$",
					"patterns": [
						{
							"include": "#string-escape"
						}
					]
				},
				{
					"name": "string.quoted.double.pegen",
					"begin": "\"",
					"end": "\"|$",
					"patterns": [
						{
							"include": "#string-escape"
						}
					]
				}
			]
		},
		"triple-string": {
			"patterns": [
				{
					"name": "string.quoted.triple.pegen",
					"begin": "'''",
					"end": "'''",
					"patterns": [
						{
							"include": "#string-escape"
						}
					]
				},
				{
					"name": "string.quoted.triple.pegen",
					"begin": "\"\"\"",
					"end": "\"\"\"",
					"patterns": [
						{
							"include": "#string-escape"
						}
					]
				}
			]
		},
		"string-escape": {
			"name": "constant.character.escape.pegen",
			"match": "\\\\."
		},
		"action": {
			"name": "meta.action.pegen",
			"begin": "\\{",
			"end": "\\}",
			"beginCaptures": {
				"0": {
					"name": "punctuation.section.action.begin.pegen"
				}
			},
			"endCaptures": {
				"0": {
					"name": "punctuation.section.action.end.pegen"
				}
			},
			"patterns": [
				{
					"include": "#action-content"
				}
			]
		},
		"action-content": {
			"patterns": [
				{
					"begin": "\\{",
					"end": "\\}",
					"patterns": [
						{
							"include": "#action-content"
						}
					]
				},
				{
					"include": "#strings"
				},
				{
					"name": "comment.line.double-slash.pegen",
					"match": "//.*$"
				},
				{
					"name": "comment.block.pegen",
					"begin": "/\\*",
					"end": "\\*/"
				},
				{
					"name": "constant.language.pegen",
					"match": "\\b(True|False|None|NULL)\\b"
				},
				{
					"name": "constant.numeric.pegen",
					"match": "\\b\\d+\\b"
				}
			]
		}
	},
	"scopeName": "source.gram"
}
