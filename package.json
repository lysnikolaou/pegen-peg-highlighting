{
    "name": "pegen-peg",
    "displayName": "Pegen PEG Grammar Highlighting",
    "description": "Syntax highlighting for the PEG syntax that the pegen project uses",
    "version": "0.3.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/lysnikolaou/pegen-peg-highlighting"
    },
    "license": "MIT",
    "publisher": "lysnikolaou",
    "engines": {
        "vscode": "^1.74.0"
    },
    "main": "./out/extension.js",
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p .",
        "watch": "tsc -watch -p ."
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [{
            "id": "pegen",
            "aliases": ["Pegen PEG", "pegen"],
            "extensions": [".gram"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "pegen",
            "scopeName": "source.gram",
            "path": "./syntaxes/pegen.tmLanguage.json"
        }]
    },
    "devDependencies": {
        "@types/node": "^16.18.126",
        "@types/vscode": "~1.74.0",
        "typescript": "^7.0.2"
    }
}
